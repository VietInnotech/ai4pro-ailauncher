{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI",
  "version": "0.1.0",
  "identifier": "com.ai4pro.localai.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI",
        "width": 960,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": []
  }
}
